{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "demo",
  "sourceRoot": "apps/shell/src",
  "tags": ["scope:shell", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/shell",
        "browser": "apps/shell/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/shell/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shell/public"
          }
        ],
        "styles": ["apps/shell/src/styles.css"],
        "define": {
          "DEMO_ONLY": "'all'"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "default-only": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "outputPath": "dist/apps/shell-default-only",
          "define": {
            "DEMO_ONLY": "'default'"
          }
        },
        "onpush-only": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "outputPath": "dist/apps/shell-onpush-only",
          "define": {
            "DEMO_ONLY": "'onpush'"
          }
        },
        "signals-only": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "outputPath": "dist/apps/shell-signals-only",
          "define": {
            "DEMO_ONLY": "'signals'"
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "shell:build:production"
        },
        "development": {
          "buildTarget": "shell:build:development"
        },
        "default-only": {
          "buildTarget": "shell:build:default-only",
          "port": 4201
        },
        "onpush-only": {
          "buildTarget": "shell:build:onpush-only",
          "port": 4202
        },
        "signals-only": {
          "buildTarget": "shell:build:signals-only",
          "port": 4203
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "shell:build",
        "staticFilePath": "dist/apps/shell/browser",
        "spa": true
      }
    }
  }
}
